# Cloudflare Pages response headers.
#
# HSTS without includeSubDomains, so nothing else under omnimem.org is forced
# onto HTTPS by this site. The CSP only stops the site being framed: the
# homepage still carries inline scripts and styles.
/*
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Fonts never change under the same name: a new font gets a new file name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
