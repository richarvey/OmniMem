# OmniMem's settings, read by the omnimem service when it starts. Everything
# here is optional: uncomment and change what you need, then
#
#   sudo systemctl restart omnimem
#
# The full list, with every default, is in docs/configuration.md. This file
# can hold secrets, so it's readable by root only; the service reads it before
# it drops to the omnimem user.

# Where the MCP server listens: http://<MCP_HOST>:<MCP_PORT>/mcp. Anything
# other than 127.0.0.1 or ::1 needs MCP_AUTH_TOKEN or OAuth below, or
# OmniMem refuses to start rather than serve your memory to the network.
MCP_HOST=127.0.0.1
MCP_PORT=8765

# A token every client must send as "Authorization: Bearer <token>".
# Make one with: openssl rand -hex 32
#MCP_AUTH_TOKEN=

# The address clients use, when a reverse proxy or tunnel sits in front.
#MCP_PUBLIC_URL=https://omnimem.example.com

# OAuth 2.1, for claude.ai and other clients that sign in through a browser.
#OAUTH_ENABLED=true
#OAUTH_BASE_URL=https://omnimem.example.com
#OAUTH_ADMIN_USER=
#OAUTH_ADMIN_PASSWORD=

# Claude features: fact extraction, query expansion, contradiction checks and
# RSS summaries. Without a key OmniMem still works, summarising by truncation.
#ANTHROPIC_API_KEY=

# RSS: the reading list is /var/lib/omnimem/feeds.yml, checked every
# RSS_SCHEDULE_HOURS and whenever the file changes.
#RSS_SCHEDULE_HOURS=6

# Logging: error, warn, info or debug. The service's log is in the journal:
#   journalctl -u omnimem -f
#OMNIMEM_LOG=info
