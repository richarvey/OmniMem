VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=changeme
MCP_PORT=8765
MCP_HOST=127.0.0.1
# MCP_TRANSPORT=http              # "http" (Streamable HTTP, recommended) or "sse" (deprecated)
WEB_PORT=8080
ANTHROPIC_API_KEY=your_key_here
# MCP_AUTH_TOKEN=           # Set to enable bearer token auth on the MCP endpoint
# WEB_UI_AUTH_TOKEN=        # Set to enable bearer token auth on the web dashboard

# OAuth 2.1 — enable for claude.ai remote MCP connections
# OAUTH_ENABLED=true
# OAUTH_BASE_URL=           # Externally-reachable URL (e.g. https://mcp.example.com)
# OAUTH_ADMIN_USER=admin
# OAUTH_ADMIN_PASSWORD=     # Strong password for the admin user
EMBEDDING_MODEL=all-MiniLM-L6-v2
RSS_SCHEDULE_HOURS=6
RSS_MAX_ARTICLES_PER_FEED=20
MEMORY_RECALL_TOP_K=5
DEPRIORITISED_WEIGHT=0.2
RECENCY_DECAY_DAYS=90
BACKUP_DIR=/app/backups
DEDUP_SIMILARITY_THRESHOLD=0.92
CONTRADICTION_SIMILARITY_THRESHOLD=0.7
STALE_MEMORY_DAYS=30
AUTO_MAINTENANCE_INTERVAL=10
