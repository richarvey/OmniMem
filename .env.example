VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=changeme
MCP_PORT=8765
MCP_HOST=127.0.0.1
# MCP_TRANSPORT=http              # "http" (Streamable HTTP, recommended) or "sse" (deprecated)
WEB_PORT=8080
ANTHROPIC_API_KEY=your_key_here
# MCP_AUTH_TOKEN=           # Set to enable bearer token auth on the MCP endpoint
# WEB_UI_AUTH_TOKEN=        # Set to enable bearer token auth on the web dashboard

# OAuth 2.1 — enable for claude.ai remote MCP connections
# OAUTH_ENABLED=true
# OAUTH_BASE_URL=           # Externally-reachable URL (e.g. https://mcp.example.com)
# OAUTH_ADMIN_USER=admin
# OAUTH_ADMIN_PASSWORD=     # Strong password for the admin user
# OAUTH_REFRESH_MAX_DAYS=30 # Absolute lifetime of a refresh-token chain. Each
                            # rotation issues a fresh access token without
                            # re-prompting the user, until this cap is reached.
                            # Default 30, hard-capped at 90.
# OAUTH_REFRESH_GRACE_SECONDS=120 # After a refresh token rotates, the old token
                            # keeps working for this long and replays return the
                            # same new pair. Stops claude.ai being logged out when
                            # several connections refresh at once. Default 120,
                            # capped at 3600, set 0 for strict single-use rotation.
# OAUTH_LOGIN_MAX_ATTEMPTS=10   # Failed admin logins per IP before the login form
# OAUTH_LOGIN_WINDOW_SECONDS=900 # is blocked for the window. Set MAX_ATTEMPTS=0 to disable.
EMBEDDING_MODEL=all-MiniLM-L6-v2
RSS_SCHEDULE_HOURS=6
RSS_MAX_ARTICLES_PER_FEED=20
MEMORY_RECALL_TOP_K=5
DEPRIORITISED_WEIGHT=0.2
RECENCY_DECAY_DAYS=90
# Query expansion: generate alternative phrasings via Claude Haiku to improve recall
# coverage when query vocabulary doesn't match stored content. Opt-in.
RECALL_EXPAND_QUERIES=false
RECALL_EXPAND_COUNT=3
# Ingest mode: 'full' (default) extracts atomic facts via Claude before
# storing and routes preferences to the preference namespace; 'raw' stores
# verbatim. Falls back to raw automatically if no API key or extraction fails.
INGEST_MODE=full
# Batch enrichment: when true, remember_document() sends all chunks to a single
# Haiku call instead of one per chunk. Much faster for large documents but uses
# a bigger prompt. Off by default.
ENRICHMENT_BATCH_MODE=false
BACKUP_DIR=/app/backups
DEDUP_SIMILARITY_THRESHOLD=0.92
CONTRADICTION_SIMILARITY_THRESHOLD=0.7
STALE_MEMORY_DAYS=30
AUTO_MAINTENANCE_INTERVAL=10
