# OmniMem 7 settings.
#
# A starting point for /etc/omnimem/omnimem.env on a headless install, for
# `docker run --env-file`, or for the desktop app's omnimem.env in its data
# folder (though the app's Configuration page writes that for you, and keeps
# secrets in the keychain rather than here).
#
# Everything is optional: unset means the default shown. A real environment
# variable always wins over this file. The full list, with explanations, is in
# docs/configuration.md.

# --- The database ---------------------------------------------------------
# Headless default is data/omnimem.db under the working directory. The
# packages and the Docker image set their own.
# OMNIMEM_DB=/var/lib/omnimem/omnimem.db
# OMNIMEM_LOG=info

# --- MCP server -------------------------------------------------------------
# Clients connect to http://MCP_HOST:MCP_PORT/mcp. Anything other than
# loopback needs MCP_AUTH_TOKEN or OAuth, or OmniMem refuses to start.
MCP_HOST=127.0.0.1
MCP_PORT=8765
# MCP_AUTH_TOKEN=pick-a-long-random-string
# MCP_PUBLIC_URL=https://mcp.example.com     # behind a proxy or tunnel
# MCP_ALLOWED_HOSTS=alt.example.com          # extra Host headers, comma separated
# MCP_ALLOWED_ORIGINS=https://alt.example.com # extra browser origins, comma separated

# --- OAuth 2.1, for claude.ai and other sign-in clients -----------------------
# OAUTH_ENABLED=true
# OAUTH_BASE_URL=https://mcp.example.com
# OAUTH_ADMIN_USER=admin
# OAUTH_ADMIN_PASSWORD=a-strong-password
# OAUTH_REFRESH_MAX_DAYS=30          # 1 to 90
# OAUTH_REFRESH_GRACE_SECONDS=120    # 0 makes refresh tokens single use
# OAUTH_LOGIN_MAX_ATTEMPTS=10        # 0 turns the login limit off
# OAUTH_LOGIN_WINDOW_SECONDS=900

# --- Claude (all optional) ----------------------------------------------------
# Without a key: no fact extraction, no query expansion, no contradiction
# confirmation, and RSS articles are truncated instead of summarised.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# INGEST_MODE=full                   # full or raw
# ENRICHMENT_BATCH_MODE=false
# FACT_EXTRACTION_MODEL=claude-haiku-4-5-20251001
# RECALL_EXPAND_QUERIES=false
# RECALL_EXPAND_COUNT=3
# QUERY_EXPANSION_MODEL=claude-haiku-4-5-20251001

# --- Recall and maintenance -----------------------------------------------------
# MEMORY_RECALL_TOP_K=5
# RECALL_MIN_SCORE=0.15              # 0 keeps everything
# RECALL_WEAK_SCORE=0.35             # 0 turns the weak_match marker off
# RECENCY_DECAY_DAYS=90
# DEPRIORITISED_WEIGHT=0.2
# DEDUP_SIMILARITY_THRESHOLD=0.92
# CONTRADICTION_SIMILARITY_THRESHOLD=0.7
# STALE_MEMORY_DAYS=30
# AUTO_MAINTENANCE_INTERVAL=10       # 0 turns auto-maintenance off
# ABANDONED_CACHE_TTL_SECONDS=60
# PROJECT_DOMAIN_CACHE_TTL_SECONDS=60
# BACKUP_DIR=/var/lib/omnimem/backups # default: backups/ beside the database

# --- RSS ------------------------------------------------------------------------
# FEEDS_CONFIG_PATH=/var/lib/omnimem/feeds.yml # default: beside the database
# RSS_SCHEDULE_HOURS=6               # 0 checks only at start and on changes
# FEEDS_WATCH_INTERVAL=10
# RSS_MAX_ARTICLES_PER_FEED=20
# RSS_MAX_DIGEST_ENTRIES=2
# RSS_MAX_PAGE_BYTES=10485760
# RSS_REQUIRE_LICENCE=false
# MAX_KNOWLEDGE_AGE_DAYS=30

# --- Skills -----------------------------------------------------------------------
# OMNIMEM_USER=local
# SKILL_MIN_SCORE=0.25
# SKILL_CLUSTER_THRESHOLD=0.80
# SKILL_DOMAIN_SUGGEST_THRESHOLD=0.60
# SKILL_PROPOSAL_TTL_SECONDS=86400
# SKILL_EXPORT_DIR=                  # default: skills/ inside the backup folder
# SKILL_FEED_MAX_ARTICLES=25         # 0 leaves the Feed watch section out
# SKILL_KNOWLEDGE_WATCH_DAYS=14      # 0 turns the watch off
# SKILL_KNOWLEDGE_WATCH_THRESHOLD=0.35
# SKILL_SUGGEST_MIN_SIMILARITY=0.30
# SKILL_SCAN_INTERVAL_HOURS=24       # 0 turns the automatic scan off
# SKILL_SCAN_MIN_POOL=3
# SKILL_SCAN_CROSS_PROJECT=true
# SKILL_SCAN_MAX_PROPOSALS=3

# --- Embeddings -------------------------------------------------------------------
# EMBEDDING_MODEL=all-MiniLM-L6-v2   # or owner/name, or a local folder
# EMBEDDING_MODEL_REVISION=          # pinned for the default model
# EMBEDDING_ONNX_FILE=onnx/model.onnx
# EMBEDDING_MAX_SEQ_LENGTH=          # from the model when unset
# EMBEDDING_THREADS=                 # ONNX Runtime's choice when unset
# HF_HOME=/var/lib/omnimem/hf-cache
# HF_HUB_OFFLINE=false               # true once the model is cached
# HF_TOKEN=                          # only for private or gated models
