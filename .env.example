VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=changeme
# VALKEY_MAX_CONNECTIONS=20     # Pool size for MCP server + web UI (RSS worker defaults to 50)
# VALKEY_RAW_MAX_CONNECTIONS=4  # Pool for the binary-safe client that reads stored vectors
MCP_PORT=8765
MCP_HOST=127.0.0.1
# MCP_TRANSPORT=http              # "http" (Streamable HTTP, recommended) or "sse" (deprecated)
WEB_PORT=8080
ANTHROPIC_API_KEY=your_key_here
# MCP_AUTH_TOKEN=           # Set to enable bearer token auth on the MCP endpoint
# WEB_UI_AUTH_TOKEN=        # Set to enable bearer token auth on the web dashboard
# Web UI login: enabled automatically when OAUTH_ADMIN_USER + OAUTH_ADMIN_PASSWORD
# are set (same credentials as the OAuth flow). Sessions live in Valkey.
# WEB_UI_LOGIN_ENABLED=false # Opt out of the login page despite OAuth credentials
# WEB_UI_SESSION_HOURS=168   # Dashboard session lifetime (default 7 days)

# OAuth 2.1 — enable for claude.ai remote MCP connections
# OAUTH_ENABLED=true
# OAUTH_BASE_URL=           # Externally-reachable URL (e.g. https://mcp.example.com)
# OAUTH_ADMIN_USER=admin
# OAUTH_ADMIN_PASSWORD=     # Strong password for the admin user
# OAUTH_REFRESH_MAX_DAYS=30 # Absolute lifetime of a refresh-token chain. Each
                            # rotation issues a fresh access token without
                            # re-prompting the user, until this cap is reached.
                            # Default 30, hard-capped at 90.

# Reverse-proxy / tunnel access. FastMCP 3.x guards both the Host header (rejected
# with 421 Misdirected Request) and the browser Origin (rejected with 403 Forbidden
# Origin, which breaks the login page). When OAUTH_BASE_URL is set the server allows
# that hostname AND its https origin automatically, so most setups need nothing here.
# Use these only for extra hostnames/origins not covered by OAUTH_BASE_URL:
# MCP_ALLOWED_HOSTS=mcp.example.com,alt.example.com          # comma-separated
# MCP_ALLOWED_ORIGINS=https://mcp.example.com               # comma-separated, full scheme://host
# FASTMCP_HTTP_ALLOWED_HOSTS=["mcp.example.com"]            # raw FastMCP knob — JSON array, not a bare string
# FASTMCP_HTTP_ALLOWED_ORIGINS=["https://mcp.example.com"] # raw FastMCP knob — JSON array
# OAUTH_REFRESH_GRACE_SECONDS=120 # After a refresh token rotates, the old token
                            # keeps working for this long and replays return the
                            # same new pair. Stops claude.ai being logged out when
                            # several connections refresh at once. Default 120,
                            # capped at 3600, set 0 for strict single-use rotation.
# OAUTH_LOGIN_MAX_ATTEMPTS=10   # Failed admin logins per IP before the login form
# OAUTH_LOGIN_WINDOW_SECONDS=900 # is blocked for the window. Set MAX_ATTEMPTS=0 to disable.
# OAUTH_VALKEY_MAX_CONNECTIONS=5 # Pool size for the OAuth token store's Valkey client
EMBEDDING_MODEL=all-MiniLM-L6-v2
RSS_SCHEDULE_HOURS=6
RSS_MAX_ARTICLES_PER_FEED=20
# RSS_MAX_DIGEST_ENTRIES=2      # Entries per cycle for feeds set to mode: digest
# RSS_MAX_PAGE_BYTES=10485760   # Max bytes read when fetching a full article page (10 MB)
# MAX_KNOWLEDGE_AGE_DAYS=30     # Days before RSS articles expire and are auto-archived
# FEEDS_CONFIG_PATH=/app/feeds.yml # Path to feeds.yml inside the containers
# FEEDS_WATCH_INTERVAL=10       # Seconds between mtime polls of feeds.yml
MEMORY_RECALL_TOP_K=5
DEPRIORITISED_WEIGHT=0.2
RECENCY_DECAY_DAYS=90
# Query expansion: generate alternative phrasings via Claude Haiku to improve recall
# coverage when query vocabulary doesn't match stored content. Opt-in.
RECALL_EXPAND_QUERIES=false
RECALL_EXPAND_COUNT=3
# QUERY_EXPANSION_MODEL=claude-haiku-4-5-20251001 # Claude model used for query expansion
# Ingest mode: 'full' (default) extracts atomic facts via Claude before
# storing and routes preferences to the preference namespace; 'raw' stores
# verbatim. Falls back to raw automatically if no API key or extraction fails.
INGEST_MODE=full
# FACT_EXTRACTION_MODEL=claude-haiku-4-5-20251001 # Claude model used for fact extraction
# Batch enrichment: when true, remember_document() sends all chunks to a single
# Haiku call instead of one per chunk. Much faster for large documents but uses
# a bigger prompt. Off by default.
ENRICHMENT_BATCH_MODE=false
BACKUP_DIR=/app/backups
DEDUP_SIMILARITY_THRESHOLD=0.92
CONTRADICTION_SIMILARITY_THRESHOLD=0.7
STALE_MEMORY_DAYS=30
AUTO_MAINTENANCE_INTERVAL=10
# Recall caches the parsed abandoned-approach list this long between episodic
# rescans (invalidated on experience writes in-process). 0 = rescan every recall.
ABANDONED_CACHE_TTL_SECONDS=60
# Dashboard stats (counts + recent list) are cached in Valkey this long so the
# page doesn't rescan the keyspace on every load. 0 = recompute every load.
DASHBOARD_STATS_TTL=60
# METRICS_CACHE_TTL=60          # Seconds to cache /metrics results between Prometheus scrapes
# TELEMETRY_COLD_DAYS=60        # Days without recall before a memory shows as "gone cold"
# OMNIMEM_INSTRUCTIONS_CHARS=10595 # Token-overhead page calibration: MCP instructions size
# OMNIMEM_TOOL_SCHEMAS_CHARS=5835 # Token-overhead page calibration: tool schemas size

# Skill compiler (v6): compile_skill / find_skills / get_skill / bless
# OMNIMEM_USER=local            # Identity segment in skill keys: mem:skill:gen:{domain}-{user}
# SKILL_CLUSTER_THRESHOLD=0.80  # Cosine similarity for "same lesson, different episode" clustering
# SKILL_DOMAIN_SUGGEST_THRESHOLD=0.60 # Floor for the domain "did you mean" guard
# SKILL_PROPOSAL_TTL_SECONDS=86400 # How long a proposed diff stays committable via mode='write'
# SKILL_SUGGEST_MIN_SIMILARITY=0.30 # Floor for briefing skill suggestions on ongoing projects
# SKILL_EXPORT_DIR=/app/backups/skills # Root for optional export_path mirrors of compiled skills
