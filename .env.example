# OmniMem 7 settings: every one of them, with the ones commented out showing
# their default.
#
# A starting point for the desktop app's omnimem.env in its data folder
# (though its Configuration page writes that for you, and keeps secrets in the
# keychain rather than here), or for a server's settings file, which
# `omnimem serve` reads from OMNIMEM_ENV_FILE. The Linux packages install
# their own copy at /etc/omnimem/omnimem.env.
#
# A real environment variable always wins over this file. A comment can
# follow a value (MCP_PORT=8765  # like this), so a value that itself holds
# " #" needs quotes. `docker run --env-file` doesn't strip those comments;
# Docker Compose's env_file does. docs/configuration.md explains each setting.

# --- The database -------------------------------------------------------------
# feeds.yml, backups/ and skills/ sit beside it unless set below. Default:
# omnimem.db in the desktop app's data folder, or on Linux
# /var/lib/omnimem/omnimem.db where the server package is installed.
#OMNIMEM_DB=/var/lib/omnimem/omnimem.db
# error, warn, info or debug, or a filter such as omnimem_mcp=debug,info.
#OMNIMEM_LOG=info

# --- MCP server ---------------------------------------------------------------
# Clients connect to http://MCP_HOST:MCP_PORT/mcp. Anything other than
# 127.0.0.1 or ::1 needs MCP_AUTH_TOKEN or OAuth below, or OmniMem refuses to
# start rather than serve your memory to the network.
MCP_HOST=127.0.0.1
MCP_PORT=8765
# A token every client must send as "Authorization: Bearer <token>".
# Make one with: openssl rand -hex 32
#MCP_AUTH_TOKEN=
# The address clients use, when a reverse proxy or tunnel sits in front. Its
# host and origin are trusted.
#MCP_PUBLIC_URL=https://omnimem.example.com
# Extra Host headers and browser origins to accept, comma separated.
#MCP_ALLOWED_HOSTS=
#MCP_ALLOWED_ORIGINS=

# --- OAuth 2.1, for claude.ai and other clients that sign in in a browser ----
# Turned on, it needs all three settings after it or OmniMem won't start.
#OAUTH_ENABLED=false
#OAUTH_BASE_URL=https://omnimem.example.com
#OAUTH_ADMIN_USER=
#OAUTH_ADMIN_PASSWORD=
# How long a client stays signed in, 1 to 90 days.
#OAUTH_REFRESH_MAX_DAYS=30
# How long a replaced refresh token keeps working. 0 makes them single use.
#OAUTH_REFRESH_GRACE_SECONDS=120
# Failed logins from one address before it's refused for a while. 0 is no limit.
#OAUTH_LOGIN_MAX_ATTEMPTS=10
#OAUTH_LOGIN_WINDOW_SECONDS=900

# --- Claude -------------------------------------------------------------------
# Fact extraction, query expansion, contradiction checks and RSS summaries.
# Without a key OmniMem still works, summarising by truncation.
#ANTHROPIC_API_KEY=
#ANTHROPIC_BASE_URL=https://api.anthropic.com
# full stores a memory, then extracts facts in the background; raw just stores.
#INGEST_MODE=full
#ENRICHMENT_BATCH_MODE=false
#FACT_EXTRACTION_MODEL=claude-haiku-5-5
#RECALL_EXPAND_QUERIES=false
# Variants per expanded query, 1 to 10.
#RECALL_EXPAND_COUNT=3
#QUERY_EXPANSION_MODEL=claude-haiku-5-5

# --- Recall and maintenance ---------------------------------------------------
#MEMORY_RECALL_TOP_K=5
# Relevance floor on raw similarity. 0 keeps everything.
#RECALL_MIN_SCORE=0.15
# Results below this come back marked weak_match. 0 turns the marker off.
#RECALL_WEAK_SCORE=0.35
# Above 0, experience adds at most this much to a score instead of multiplying it.
#RECALL_EXPERIENCE_SPAN=0
#RECENCY_DECAY_DAYS=90
#DEPRIORITISED_WEIGHT=0.2
#DEDUP_SIMILARITY_THRESHOLD=0.92
#CONTRADICTION_SIMILARITY_THRESHOLD=0.7
#STALE_MEMORY_DAYS=30
# Briefings per project between maintenance runs. 0 turns it off.
#AUTO_MAINTENANCE_INTERVAL=10
#ABANDONED_CACHE_TTL_SECONDS=60
#PROJECT_DOMAIN_CACHE_TTL_SECONDS=60
# Default: backups/ beside the database.
#BACKUP_DIR=/var/lib/omnimem/backups

# --- RSS ----------------------------------------------------------------------
# The reading list. Default: feeds.yml beside the database.
#FEEDS_CONFIG_PATH=/var/lib/omnimem/feeds.yml
# Feeds are also checked at start and when feeds.yml changes; 0 means only then.
#RSS_SCHEDULE_HOURS=6
#FEEDS_WATCH_INTERVAL=10
#RSS_MAX_ARTICLES_PER_FEED=20
#RSS_MAX_DIGEST_ENTRIES=2
#RSS_MAX_PAGE_BYTES=10485760
# Let feeds live on this machine or the local network.
#RSS_ALLOW_PRIVATE_HOSTS=false
# Skip feeds whose feeds.yml entry declares no licence.
#RSS_REQUIRE_LICENCE=false
#MAX_KNOWLEDGE_AGE_DAYS=30

# --- Skills -------------------------------------------------------------------
#OMNIMEM_USER=local
#SKILL_MIN_SCORE=0.25
#SKILL_CLUSTER_THRESHOLD=0.80
#SKILL_DOMAIN_SUGGEST_THRESHOLD=0.60
#SKILL_PROPOSAL_TTL_SECONDS=86400
# Default: skills/ inside the backup folder.
#SKILL_EXPORT_DIR=
# 0 leaves a skill's Feed watch section out.
#SKILL_FEED_MAX_ARTICLES=25
# 0 turns the briefing's knowledge watch off.
#SKILL_KNOWLEDGE_WATCH_DAYS=14
#SKILL_KNOWLEDGE_WATCH_THRESHOLD=0.35
#SKILL_SUGGEST_MIN_SIMILARITY=0.30
# 0 turns the automatic skill scan off.
#SKILL_SCAN_INTERVAL_HOURS=24
#SKILL_SCAN_MIN_POOL=3
#SKILL_SCAN_CROSS_PROJECT=true
#SKILL_SCAN_MAX_PROPOSALS=3

# --- Embeddings ---------------------------------------------------------------
# Where the embedding model is downloaded and cached. Default:
# ~/.cache/huggingface, or XDG_CACHE_HOME/huggingface.
#HF_HOME=/var/lib/omnimem/huggingface
# Overrides HF_HOME for the model files alone.
#HF_HUB_CACHE=
# A bare name, owner/name, or a folder holding onnx/model.onnx and
# tokenizer.json. It must produce 384-dimensional vectors.
#EMBEDDING_MODEL=all-MiniLM-L6-v2
# Pinned for the default model, main otherwise.
#EMBEDDING_MODEL_REVISION=
# Re-embed (export, then import) before switching graphs.
#EMBEDDING_ONNX_FILE=onnx/model.onnx
# Token cap per text. Default: the model's own (256 for MiniLM).
#EMBEDDING_MAX_SEQ_LENGTH=
# Default: ONNX Runtime's choice.
#EMBEDDING_THREADS=
#HF_ENDPOINT=https://huggingface.co
# true once the model is cached, to never contact Hugging Face.
#HF_HUB_OFFLINE=false
# Only for a private or gated model.
#HF_TOKEN=

# --- Settings panel -----------------------------------------------------------
# These two only matter to the desktop app's settings window.
#DASHBOARD_STATS_TTL=60
#TELEMETRY_COLD_DAYS=60
